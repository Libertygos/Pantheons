{
  "name": "pantheons",
  "version": "0.1.0",
  "private": true,
  "description": "Panthéons — Le jeu des Dieux. A hidden-identity social-deduction game, gosgames tenant.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/engine build && pnpm -r build",
    "build:engine": "pnpm --filter @pantheons/engine build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @pantheons/server dev",
    "dev:client": "pnpm --filter @pantheons/client dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.8.0"
}
