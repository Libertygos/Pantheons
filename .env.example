# Pantheons server environment
PORT=2567

# Shared secret with the gosgames platform for verifying handoff tokens (HS256).
HANDOFF_JWT_SECRET=

# Secret for signing the game's own session S-JWT (independent of the handoff secret).
SESSION_JWT_SECRET=

# Cluster-internal service token for DELETE /internal/users/:id (constant-time compared).
INTERNAL_SERVICE_TOKEN=

# Postgres connection string (durable per-user store; small, user_id-keyed).
DATABASE_URL=postgres://user:pass@localhost:5432/pantheons
